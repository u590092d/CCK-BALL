// ---------------------------------------------------------
// 感度とスクロール量の基本設定
// ---------------------------------------------------------
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 
#define ZMK_POINTING_DEFAULT_SCRL_VAL 6

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// ---------------------------------------------------------
// 入力プロセッサ設定 (リスナー)
// ---------------------------------------------------------

// 1. 通常のマウス移動 (全レイヤーで有効、スクロール時はドライバが抑制)
&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

// 2. 通常のスクロール (既存設定)
&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

/ {
    // -----------------------------------------------------
    // 追加リスナー設定
    // -----------------------------------------------------

    // 3. レイヤー3専用スクロールはドライバ側(cck_ball_right.overlay)で制御するため
    // ここでのリスナー定義は不要となりました。

    // 4. トラックボール作動時にレイヤー1にする (Auto Mouse)
    automouse_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <0 2 4 5 6>; 
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        bindings = <&mo 1>;
        time-to-live-ms = <200>; // 0.2s delay
    };


};

// ---------------------------------------------------------
// マウス動作の挙動詳細設定
// ---------------------------------------------------------
&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // -----------------------------------------------------
    // カスタム挙動 (エンコーダー等)
    // -----------------------------------------------------
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    behaviors {
    };

    // -----------------------------------------------------
    // キーマップ定義
    // -----------------------------------------------------
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default
        QWERTY {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3        &kp N4        &kp N5         &kp N6        &kp N7        &kp N8        &kp N9            &kp N0            &kp BACKSPACE
&lt 5 TAB         &kp Q         &kp W         &kp E         &kp R         &kp T          &kp Y         &kp U         &kp I         &kp O             &kp P             &kp BACKSPACE
&kp LEFT_SHIFT &kp A &lt 4 S &kp D &lt 3 F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp ENTER
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B          &kp N         &kp M         &kp COMMA     &kp DOT           &none             &kp LEFT_SHIFT
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 DELETE  &lt 1 SPACE   &lt 3 LANG1    &lt 4 LANG2   &mo 2         &kp ENTER     &none             &none             &tog 1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 1: Mouse Active Layer (Auto Mouse) & Functions
        F_layers {
            bindings = <
&trans   &trans          &trans        &trans        &trans        &trans         &trans        &trans      &trans      &trans     &trans   &trans
&trans   &trans          &trans        &trans        &trans        &trans         &kp PG_UP     &kp HOME    &kp UP      &kp END    &trans   &bt BT_CLR
&trans   &none           &bt BT_CLR        &kp CAPSLOCK  &kp F7        &kp F8         &kp PG_DN     &kp LEFT    &kp DOWN    &kp RIGHT  &trans   &trans
&trans   &trans          &trans        &trans        &trans        &none          &none         &none       &trans      &trans     &none    &trans
&trans   &trans          &trans        &trans        &mkp LCLK      &mkp RCLK     &trans        &trans      &trans      &trans     &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 2: Bluetooth
        // 修正: BT_CLR_ALL を BT_CLR に変更
        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans         &trans        &trans      &trans  &trans  &trans
&trans  &kp N1          &kp N2        &kp N3        &kp N4        &kp N5          &kp N6         &kp N7        &kp N8      &kp N9  &kp N0  &trans
&trans  &kp UNDER       &kp MINUS     &kp LBRC      &kp RBRC      &trans          &trans         &kp LPAR      &kp RPAR    &trans  &trans  &trans
&trans  &kp EQUAL      &kp PLUS      &kp LBKT      &kp RBKT      &trans          &bt BT_NXT     &kp LT        &kp GT      &trans  &trans  &trans
&trans  &kp EQUAL       &trans        &trans        &trans        &trans          &trans         &trans        &trans      &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 3: Scroll Layer (with Nav/Click keys)
        scroll-layers {
            bindings = <
&trans   &trans          &trans        &trans        &trans        &trans         &trans        &trans      &trans      &trans     &trans   &trans
&trans   &trans          &trans        &trans        &trans        &trans         &kp PG_UP     &kp HOME    &kp UP      &kp END    &trans   &trans
&trans   &none           &none         &trans        &trans        &trans         &kp PG_DN     &kp LEFT    &kp DOWN    &kp RIGHT  &trans   &trans
&trans   &trans          &trans        &trans        &trans        &none          &none         &none       &trans      &trans     &none    &trans
&trans   &trans          &trans        &trans        &trans        &mkp LCLK      &mkp RCLK     &trans      &trans      &trans     &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 4: Snipe / Symbols
        snipe-layers {
            bindings = <
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &trans      &trans     &trans    &trans    &trans
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET   &kp AMPS    &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &kp FSLH    &kp ASTRK  &kp EQUAL &kp PIPE  &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &kp PRCNT   &kp AMPS   &trans    &trans    &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &trans      &trans     &trans    &trans    &trans
            >;
            // 修正: カンマ区切りではなくスペース区切りにして <> で括る (標準的なZMK構文)
            sensor-bindings = <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        // Layer 5: Function Keys
        layer_5 {
            bindings = <
&trans  &kp F1    &kp F2  &kp F3    &kp F4    &kp F5     &trans      &trans      &trans     &trans    &trans    &trans
&trans  &kp F6    &kp F7  &kp F8    &kp F9    &kp F10    &kp CARET   &kp AMPS    &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &kp F11   &kp F12 &trans    &trans    &kp INS    &trans      &kp FSLH    &kp ASTRK  &kp EQUAL &kp PIPE  &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &kp PRCNT   &kp AMPS   &trans    &trans    &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &trans      &trans     &trans    &trans    &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        // Layer 6: New Layer
        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};